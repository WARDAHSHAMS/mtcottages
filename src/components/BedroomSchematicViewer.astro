---
interface Props {
  roomId: string;
  roomLabel: string;
  bedLabel: string;
  features: string[];
  bedSize: "king" | "double" | "queen";
}

const { roomId, roomLabel, features } = Astro.props;
---

<div class="schematic" data-room-viewer={roomId}>
  <div class="schematic-controls">
    <button type="button" class="button" data-load-plan aria-expanded="false">Open floor plan</button>
    <p class="text-muted">{roomLabel}</p>
  </div>
  <div class="plan-stage" data-plan-stage hidden>
  <figure class="plan">
    {roomId === "bedroom-1" && (
      <svg viewBox="0 0 360 272" role="img" aria-label="Floor plan of blue king bedroom, 265 square feet">
        <defs>
          <pattern id="fp1dots" width="9" height="9" patternUnits="userSpaceOnUse">
            <circle cx="2" cy="2" r="0.8" fill="#2f3a2e" opacity="0.18" />
          </pattern>
        </defs>
        <rect x="40" y="30" width="260" height="200" fill="#dfe7ee" stroke="#2f3a2e" stroke-width="6" />
        <rect x="46" y="36" width="248" height="188" fill="url(#fp1dots)" />
        <rect x="37" y="112" width="6" height="40" fill="#fff" stroke="#2e7fbf" stroke-width="2.5" />
        <line x1="31" y1="132" x2="36" y2="132" stroke="#2e7fbf" stroke-width="1.5" />
        <text x="2" y="129" class="fp-dim">3′-0″</text>
        <rect x="297" y="162" width="6" height="36" fill="#fff" stroke="#2e7fbf" stroke-width="2.5" />
        <rect x="297" y="78" width="6" height="36" fill="#fff" stroke="#2e7fbf" stroke-width="2.5" />
        <line x1="304" y1="180" x2="314" y2="180" stroke="#2e7fbf" stroke-width="1.5" />
        <line x1="304" y1="96" x2="314" y2="96" stroke="#2e7fbf" stroke-width="1.5" />
        <text x="318" y="177" class="fp-dim">3′-0″</text>
        <text x="318" y="93" class="fp-dim">3′-0″</text>
        <rect x="215" y="227" width="36" height="6" fill="#6b3418" />
        <path d="M 249 227 A 34 34 0 0 1 215 193" fill="none" stroke="#2f3a2e" stroke-width="1.5" stroke-dasharray="4 2" />
        <rect x="108" y="27" width="40" height="6" fill="#fff" stroke="#2e7fbf" stroke-width="2.5" />
        <rect x="212" y="27" width="40" height="6" fill="#fff" stroke="#2e7fbf" stroke-width="2.5" />
        <line x1="128" y1="26" x2="128" y2="18" stroke="#2e7fbf" stroke-width="1.5" />
        <line x1="232" y1="26" x2="232" y2="18" stroke="#2e7fbf" stroke-width="1.5" />
        <text x="128" y="16" class="fp-dim" text-anchor="middle">3′-0″</text>
        <text x="232" y="16" class="fp-dim" text-anchor="middle">3′-0″</text>
        <rect x="142" y="40" width="76" height="92" fill="#dde3ea" stroke="#2f3a2e" stroke-width="2" />
        <rect x="140" y="40" width="80" height="8" rx="2" fill="#2f3a2e" />
        <rect x="148" y="52" width="30" height="12" fill="#fff" stroke="#2f3a2e" stroke-width="1.5" />
        <rect x="182" y="52" width="30" height="12" fill="#fff" stroke="#2f3a2e" stroke-width="1.5" />
        <text x="170" y="150" class="fp-eyebrow">FLOOR PLAN</text>
        <text x="170" y="168" class="fp-label">Bedroom 1</text>
        <text x="170" y="187" class="fp-sf">265 SF</text>
      </svg>
    )}
    {roomId === "bedroom-2" && (
      <svg viewBox="0 0 360 272" role="img" aria-label="Floor plan of green double bedroom, 281 square feet">
        <defs>
          <pattern id="fp2wood" width="6" height="6" patternUnits="userSpaceOnUse">
            <line x1="1" y1="0" x2="1" y2="6" stroke="#2f3a2e" stroke-width="0.7" opacity="0.22" />
          </pattern>
        </defs>
        <rect x="40" y="30" width="260" height="200" fill="#e9e2d2" stroke="#2f3a2e" stroke-width="6" />
        <rect x="46" y="36" width="248" height="188" fill="url(#fp2wood)" />
        <rect x="150" y="27" width="60" height="6" fill="#fff" stroke="#2e7fbf" stroke-width="2.5" />
        <line x1="150" y1="22" x2="150" y2="27" stroke="#2e7fbf" stroke-width="1.5" />
        <line x1="210" y1="22" x2="210" y2="27" stroke="#2e7fbf" stroke-width="1.5" />
        <text x="180" y="17" class="fp-dim" text-anchor="middle">3′-0″</text>
        <rect x="37" y="112" width="6" height="36" fill="#fff" stroke="#2e7fbf" stroke-width="2.5" />
        <line x1="31" y1="130" x2="36" y2="130" stroke="#2e7fbf" stroke-width="1.5" />
        <text x="2" y="133" class="fp-dim">3′-0″</text>
        <rect x="297" y="150" width="6" height="40" fill="#6b3418" />
        <path d="M 300 190 A 38 38 0 0 0 264 170" fill="none" stroke="#2f3a2e" stroke-width="1.5" stroke-dasharray="4 2" />
        <rect x="90" y="227" width="30" height="6" fill="#fff" stroke="#2f3a2e" stroke-width="1.5" />
        <rect x="140" y="227" width="56" height="6" fill="#fff" stroke="#2f3a2e" stroke-width="1.5" />
        <rect x="210" y="227" width="30" height="6" fill="#fff" stroke="#2f3a2e" stroke-width="1.5" />
        <rect x="52" y="42" width="84" height="66" fill="#dde3ea" stroke="#2f3a2e" stroke-width="2" />
        <rect x="50" y="38" width="88" height="8" rx="2" fill="#2f3a2e" />
        <rect x="58" y="48" width="34" height="16" fill="#fff" stroke="#2f3a2e" stroke-width="1.5" />
        <rect x="96" y="48" width="34" height="16" fill="#fff" stroke="#2f3a2e" stroke-width="1.5" />
        <text x="170" y="134" class="fp-eyebrow">FLOOR PLAN</text>
        <text x="170" y="150" class="fp-label">Bedroom 2</text>
        <text x="170" y="169" class="fp-sf">281 SF</text>
      </svg>
    )}
    {roomId === "bedroom-3" && (
      <svg viewBox="0 0 360 272" role="img" aria-label="Floor plan of orange queen bedroom, 268 square feet">
        <defs>
          <pattern id="fp3dots" width="9" height="9" patternUnits="userSpaceOnUse">
            <circle cx="2" cy="2" r="0.8" fill="#2f3a2e" opacity="0.18" />
          </pattern>
        </defs>
        <rect x="40" y="30" width="260" height="200" fill="#ece7db" stroke="#2f3a2e" stroke-width="6" />
        <rect x="46" y="36" width="248" height="188" fill="url(#fp3dots)" />
        <rect x="190" y="27" width="50" height="6" fill="#fff" stroke="#2e7fbf" stroke-width="2" />
        <line x1="215" y1="28" x2="215" y2="32" stroke="#2f3a2e" stroke-width="1.5" />
        <rect x="140" y="42" width="80" height="66" fill="#dde3ea" stroke="#2f3a2e" stroke-width="2" />
        <rect x="138" y="38" width="84" height="8" rx="2" fill="#2f3a2e" />
        <rect x="148" y="48" width="30" height="14" fill="#fff" stroke="#2f3a2e" stroke-width="1.5" />
        <rect x="182" y="48" width="30" height="14" fill="#fff" stroke="#2f3a2e" stroke-width="1.5" />
        <rect x="37" y="104" width="6" height="34" fill="#fff" stroke="#2e7fbf" stroke-width="2.5" />
        <line x1="31" y1="121" x2="36" y2="121" stroke="#2e7fbf" stroke-width="1.5" />
        <text x="2" y="124" class="fp-dim">3′-0″</text>
        <rect x="297" y="66" width="6" height="34" fill="#fff" stroke="#2e7fbf" stroke-width="2.5" />
        <rect x="297" y="148" width="6" height="34" fill="#fff" stroke="#2e7fbf" stroke-width="2.5" />
        <line x1="304" y1="83" x2="314" y2="83" stroke="#2e7fbf" stroke-width="1.5" />
        <line x1="304" y1="165" x2="314" y2="165" stroke="#2e7fbf" stroke-width="1.5" />
        <text x="318" y="86" class="fp-dim">3′-0″</text>
        <text x="318" y="168" class="fp-dim">3′-0″</text>
        <rect x="60" y="227" width="34" height="6" fill="#6b3418" />
        <path d="M 60 230 A 34 34 0 0 1 92 202" fill="none" stroke="#2f3a2e" stroke-width="1.5" stroke-dasharray="4 2" />
        <rect x="200" y="227" width="60" height="6" fill="#fff" stroke="#2e7fbf" stroke-width="1.5" />
        <text x="170" y="124" class="fp-eyebrow">FLOOR PLAN</text>
        <text x="170" y="140" class="fp-label">Bedroom 3</text>
        <text x="170" y="159" class="fp-sf">268 SF</text>
      </svg>
    )}
  </figure>
  </div>

  <ul class="checklist schematic-facts">{features.map((f) => <li>{f}</li>)}</ul>
</div>

<script>
  document.querySelectorAll("[data-room-viewer]").forEach((root) => {
    if (root.dataset.planBound === "true") return;
    root.dataset.planBound = "true";
    const btn = root.querySelector("[data-load-plan]");
    const stage = root.querySelector("[data-plan-stage]");
    btn?.addEventListener("click", () => {
      const open = stage.hidden;
      stage.hidden = !open;
      btn.setAttribute("aria-expanded", String(open));
      btn.textContent = open ? "Close floor plan" : "Open floor plan";
      if (open) stage.scrollIntoView({ behavior: "smooth", block: "center" });
    });
  });
</script>

<style>
  .schematic { border: 1px solid var(--line); border-radius: var(--radius); background: var(--paper); padding: 1rem; margin-top: 1rem; }
  .plan svg { width: 100%; height: auto; background: #fff; border: 1px solid var(--line); border-radius: .6rem; }
  .plan .fp-eyebrow { font-size: 9px; font-family: var(--mono); letter-spacing: .14em; fill: var(--muted); text-anchor: middle; }
  .plan .fp-label { font-size: 17px; font-weight: 700; fill: var(--forest); text-anchor: middle; }
  .plan .fp-sf { font-size: 13px; fill: var(--muted); text-anchor: middle; }
  .plan .fp-dim { font-size: 9px; font-family: var(--mono); fill: #2e7fbf; }
  .schematic-controls { display: flex; flex-wrap: wrap; gap: .6rem; align-items: center; margin: .8rem 0; }
  .plan-stage { display: block; }
  .plan-stage[hidden] { display: none; }
  .schematic-facts { margin-top: .6rem; }
</style>
