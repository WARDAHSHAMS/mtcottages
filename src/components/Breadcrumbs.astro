---
// The one visible breadcrumb trail (#35). Pass the same list to SiteLayout's
// `breadcrumbs` prop, which publishes it as the page's only BreadcrumbList;
// scripts/check-links.mjs fails the build when the two disagree.
import type { Crumb } from "../data/schema";

interface Props {
  items: Crumb[];
}

const { items } = Astro.props as Props;
---

<nav class="crumbs" aria-label="Breadcrumb">
  {items.map((item, index) => index < items.length - 1
    ? <><a href={item.href}>{item.name}</a><span aria-hidden="true">/</span></>
    : <span aria-current="page">{item.name}</span>)}
</nav>
