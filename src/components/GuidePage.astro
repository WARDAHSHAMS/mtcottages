---
import ResponsivePhoto from "./ResponsivePhoto.astro";
import PropertyCard from "./PropertyCard.astro";
import CheckDates from "./CheckDates.astro";
import { type Cottage, type Guide } from "../data/site";
import { stayLink } from "../data/stay-link";
import type { Crumb } from "../data/schema";

interface Props {
  guide: Guide;
  cottages?: Cottage[];
  /** Full visible trail, ending with this page; the same list feeds the page's BreadcrumbList. */
  crumbs?: Crumb[];
}

const { guide, cottages = [], crumbs } = Astro.props;
const heroHref = guide.actionHref || stayLink({ audience: guide.audience, town: guide.stayTown, page: Astro.url.pathname });
---

<section class="guide-hero section--tight">
  <div class="site-width guide-hero-grid">
    <div>
      {crumbs ? (
        <nav class="crumbs" aria-label="Breadcrumb">
          {crumbs.map((crumb, index) => index < crumbs.length - 1
            ? <><a href={crumb.href}>{crumb.name}</a><span aria-hidden="true">/</span></>
            : <span aria-current="page">{crumb.name}</span>)}
        </nav>
      ) : (
        <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span>{guide.eyebrow}</span></nav>
      )}
      <p class="eyebrow mt-3">{guide.eyebrow}</p>
      <h1>{guide.title}</h1>
      <p class="lede">{guide.description}</p>
      <p class="mt-2 reading">{guide.intro}</p>
      <div class="cluster mt-3" data-cta="hero"><a class="button" href={heroHref}>{guide.cta || "Find your place"} <span aria-hidden="true">↗</span></a></div>
    </div>
    {guide.photo && <figure class="hero-image-frame"><ResponsivePhoto {...guide.photo} priority sizes="(max-width: 900px) 100vw, 55vw" /><figcaption class="sr-only">{guide.photo.alt}</figcaption></figure>}
  </div>
</section>

<section class="section section--paper">
  <div class="site-width prose">
    {guide.sections.map((section) => (
      <article class="prose-section">
        <h2>{section.title}</h2>
        <div class="stack"><p>{section.body}</p>{section.bullets && <ul>{section.bullets.map((bullet) => <li>{bullet}</li>)}</ul>}</div>
      </article>
    ))}
  </div>
</section>

{cottages.length > 0 && <section class="section"><div class="site-width"><div class="section-heading"><div><p class="eyebrow">Homes to consider</p><h2>Places to consider.</h2></div><p>Furnished, connected homes with fiber-optic internet and quiet, peaceful living. Availability changes, so start here and we will confirm your dates and the details.</p></div><div class="card-grid">{cottages.map((cottage) => <PropertyCard cottage={cottage} />)}</div></div></section>}

{guide.inquiryCta !== false && <section class="section section--dark"><div class="site-width split split--wide"><div><p class="eyebrow" style="color:#e4b482">The next step</p><h2>Tell us what would make the place work.</h2></div><div><p class="lede lede--light">Share your dates, preferred community, household, and the reason for your stay. We will follow up with the furnished homes that fit and the right next step.</p><CheckDates class="mt-3" placement="next-step" audience={guide.audience} town={guide.stayTown} tone="light" /></div></div></section>}
