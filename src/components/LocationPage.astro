---
import GuidePage from "./GuidePage.astro";
import type { Guide, Cottage } from "../data/site";
import type { Crumb } from "../data/schema";

interface Props {
  guide: Guide & { town: string; cottages?: Cottage[] };
  crumbs?: Crumb[];
}

const { guide, crumbs } = Astro.props;
---
<GuidePage guide={guide} cottages={guide.cottages} crumbs={crumbs} />
