---
/**
 * Memorial Health System landing (#33), built like the travel-nurse hub
 * (TravelNurseHub.astro): a hero with one CTA, the measured drive from each
 * nearby home to both Memorial hospitals (a table), Frederick Cottage in
 * brief, a #residents section for Memorial's two residencies with their
 * sources, terms stated only as far as they are confirmed, native FAQ
 * disclosures that match the FAQPage schema, the nearby homes, and the
 * no-affiliation disclaimer. Data and honesty rules: src/data/memorialHealth.ts.
 */
import "../styles/town-landing.css";
import "../styles/travel-nurses.css";
import ResponsivePhoto from "./ResponsivePhoto.astro";
import PropertyCard from "./PropertyCard.astro";
import { cottages } from "../data/site";
import { stayLink } from "../data/stay-link";
import type { Crumb } from "../data/schema";
import type { Photo } from "../data/site";
import {
  campuses, disclaimer, driveRows, driveSource, faqs, frederick, frederickFacts, hubHref, page, residency, terms,
} from "../data/memorialHealth";

interface Props {
  crumbs: Crumb[];
  hero: Photo;
}

const { crumbs, hero } = Astro.props;
// Every inquiry link carries the home, the audience and this page as its source (#20).
const pathname = Astro.url.pathname;
const inquiryHref = stayLink({ home: frederick.id, audience: "healthcare", page: pathname });
const homeCards = driveRows.map(({ home }) => {
  const cottage = cottages.find((entry) => entry.id === home.id);
  if (!cottage) throw new Error(`The Memorial page lists "${home.id}", which is not in src/data/site.ts`);
  return { home, cottage };
});
const frederickHref = `/${frederick.town.slug}/${frederick.slug}/`;
---

<section class="guide-hero section--tight tl-hero">
  <div class="site-width guide-hero-grid">
    <div>
      <nav class="crumbs" aria-label="Breadcrumb">
        {crumbs.map((crumb, index) => index < crumbs.length - 1
          ? <><a href={crumb.href}>{crumb.name}</a><span aria-hidden="true">/</span></>
          : <span aria-current="page">{crumb.name}</span>)}
      </nav>
      <p class="eyebrow mt-3">{page.eyebrow}</p>
      <h1>{page.h1}</h1>
      <p class="lede" data-testid="memorial-lede">{page.lede}</p>
      <p class="mt-2 reading">{page.intro}</p>
      <div class="cluster mt-3" data-cta="hero">
        <a class="button" href={inquiryHref}>{page.inquiryLabel} <span aria-hidden="true">↗</span></a>
        <a class="button button--ghost" href="#residents">For residents</a>
      </div>
    </div>
    <figure class="hero-image-frame">
      <ResponsivePhoto {...hero} priority sizes="(max-width: 900px) 100vw, 55vw" />
    </figure>
  </div>
</section>

<section class="section section--paper" id="drives" aria-labelledby="mh-drives-title">
  <div class="site-width">
    <div class="section-heading">
      <div><p class="eyebrow">Measured, not guessed</p><h2 id="mh-drives-title">The drive to both Memorial hospitals</h2></div>
      <p>Memorial Health System runs two hospitals in Marietta, Ohio. Here is the drive from each of our homes with a published address, nearest first.</p>
    </div>
    <div class="tl-table-scroll" role="region" aria-labelledby="mh-drives-caption" tabindex="0">
      <table class="tl-table" data-testid="memorial-drives">
        <caption id="mh-drives-caption" class="sr-only">Drive time and distance from each home to Marietta Memorial Hospital and Selby General Hospital</caption>
        <thead>
          <tr><th scope="col">Home</th>{campuses.map((campus) => <th scope="col">{campus.name}</th>)}</tr>
        </thead>
        <tbody>
          {driveRows.map((row) => (
            <tr data-home={row.home.id}>
              <th scope="row"><a href={`/${row.home.town.slug}/${row.home.slug}/`}>{row.home.name}</a><small class="tl-miles"> {row.place}</small></th>
              {row.drives.map((line, index) => (
                <td data-destination={campuses[index].id}><strong>{line.minutes} min</strong> <span class="tl-miles">{line.miles.toFixed(1)} mi</span></td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="details-note mt-2" data-testid="drive-source">{driveSource}</p>
  </div>
</section>

<section class="section" id="frederick" aria-labelledby="mh-frederick-title">
  <div class="site-width split">
    <div class="stack">
      <p class="eyebrow">The nearest home</p>
      <h2 id="mh-frederick-title">Frederick Cottage, on Marietta's east side</h2>
      <ul class="checklist" role="list" data-testid="frederick-facts">{frederickFacts.map((fact) => <li><span>{fact}</span></li>)}</ul>
      <p><a class="inline-link" href={frederickHref}>See Frederick Cottage: photos, plan and map <span aria-hidden="true">→</span></a></p>
    </div>
    <div class="stack">
      <p class="eyebrow">Not on Memorial staff?</p>
      <h2>Every hospital, every home</h2>
      <p class="reading">Taking a contract at Camden Clark in Parkersburg or Jackson General in Ripley instead? The travel-nurse page compares every home and hospital and sets the federal lodging per diem beside our guide prices.</p>
      <p><a class="inline-link" href={hubHref}>Travel nurse housing and the stipend guide <span aria-hidden="true">→</span></a></p>
    </div>
  </div>
</section>

<section class="section section--paper" id="residents" aria-labelledby="mh-residents-title">
  <div class="site-width">
    <div class="section-heading">
      <div><p class="eyebrow">Medical residents</p><h2 id="mh-residents-title">Housing for Memorial Health System residents</h2></div>
      <p>A residency keeps you in one place for three years: long enough that a hotel stops making sense, often too short to buy a house. Memorial Health System trains residents in two programmes.</p>
    </div>
    <ul class="card-grid tn-hospitals" role="list" data-testid="residency-programmes">
      {residency.programmes.map((programme) => (
        <li class="tn-hospital" data-programme={programme.id}>
          <p class="location">Memorial Health System</p>
          <h3>{programme.name}</h3>
          <ul class="checklist" role="list">{programme.facts.map((fact) => <li><span>{fact}</span></li>)}</ul>
          <p class="tn-sources">Source: {programme.sources.map((source, index) => <>{index > 0 && " · "}<a href={source.href} rel="noopener">{source.label}</a></>)}</p>
        </li>
      ))}
    </ul>
    <div class="tn-reading mt-4 stack reading">
      <h3>What that means for your housing</h3>
      <ul class="checklist" role="list" data-testid="residency-housing">{residency.housing.map((item) => <li><span>{item}</span></li>)}</ul>
      <p class="text-muted">Programme details read from Memorial Health System's public pages in {residency.checked}; the programmes can change them. Overview: <a href={residency.overview.href} rel="noopener">{residency.overview.label}</a>.</p>
    </div>
  </div>
</section>

<section class="section" id="terms" aria-labelledby="mh-terms-title">
  <div class="site-width split">
    <div class="stack">
      <p class="eyebrow">13-week contracts and longer</p>
      <h2 id="mh-terms-title">What we state, and what we confirm first</h2>
      <ul class="checklist" role="list" data-testid="terms-stated">{terms.stated.map((item) => <li><span>{item}</span></li>)}</ul>
    </div>
    <div class="stack">
      <p class="eyebrow">Confirm on inquiry</p>
      <h2>Not confirmed for every home yet</h2>
      <ul class="tl-confirm" role="list" data-testid="terms-confirm">{terms.confirm.map((item) => <li>{item}</li>)}</ul>
    </div>
  </div>
</section>

<section class="section section--paper" id="faq" aria-labelledby="mh-faq-title">
  <div class="site-width split split--wide">
    <div>
      <p class="eyebrow">Questions</p>
      <h2 id="mh-faq-title">Housing near Marietta Memorial, answered</h2>
    </div>
    <div class="faq">
      {faqs.map((faq) => (
        <details>
          <summary>{faq.q}</summary>
          <p>{faq.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<section class="section" id="homes" aria-labelledby="mh-homes-title">
  <div class="site-width">
    <div class="section-heading">
      <div><p class="eyebrow">Nearby homes</p><h2 id="mh-homes-title">Furnished homes within a short drive of Memorial</h2></div>
      <p>Guide prices are for planning; we confirm the current price and what it covers before you commit. Only Frederick's guide price is owner-confirmed.</p>
    </div>
    <div class="card-grid">
      {homeCards.map(({ home, cottage }) => (
        <div class="tn-card" data-home={home.id}><PropertyCard cottage={cottage} headingLevel={3} /></div>
      ))}
    </div>
    <p class="mt-3">Or start from the town: <a class="inline-link tn-inline" href="/marietta/index.html">Furnished rentals in Marietta, Ohio</a> · <a class="inline-link tn-inline" href="/parkersburg/index.html">Parkersburg, WV</a></p>
  </div>
</section>

<section class="section" aria-labelledby="mh-disclaimer-title">
  <div class="site-width">
    <h2 id="mh-disclaimer-title" class="tn-small-heading">No affiliation</h2>
    <p class="details-note mt-2" data-testid="disclaimer">{disclaimer}</p>
  </div>
</section>

<section class="section section--dark" aria-labelledby="mh-next-title">
  <div class="site-width split split--wide">
    <div>
      <p class="eyebrow tl-eyebrow-light">The next step</p>
      <h2 id="mh-next-title">Tell us your contract or residency dates.</h2>
    </div>
    <div>
      <p class="lede lede--light">Share your start and end dates, which hospital or programme, and who is coming. We reply with the homes that fit, their current price and what is included. An inquiry is a conversation, not a lease.</p>
      <a class="button button--light mt-3" href={inquiryHref} data-cta="next-step">{page.inquiryLabel} <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>
