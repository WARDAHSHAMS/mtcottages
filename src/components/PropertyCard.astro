---
import ResponsivePhoto from "./ResponsivePhoto.astro";
import { cottages, type Cottage } from "../data/site";
import { cardTerms } from "../data/terms";
const { cottage } = Astro.props as { cottage: Cottage };
const terms = cardTerms(cottage.id);
const mainHref = `/${cottage.path}`;
---

<article class="property-card">
  <a href={mainHref} aria-label={`View ${cottage.name}`}>
    <figure>
      <ResponsivePhoto {...cottage.hero} widths={[360, 640, 900]} sizes="(max-width: 560px) 100vw, (max-width: 900px) 50vw, 33vw" />
    </figure>
  </a>
  <div class="property-card-body">
    <p class="property-card-number" aria-hidden="true">{String(cottages.findIndex((entry) => entry.id === cottage.id) + 1).padStart(2, "0")}</p>
    <div>
      <h2><a href={mainHref}>{cottage.name}</a></h2>
      <p class="location">{cottage.town}</p>
    </div>
    <div class="property-meta"><span>{cottage.bedrooms}</span><span>{cottage.signals.homeType}</span><span>{cottage.signals.connectivity}</span><span>{cottage.signals.setting}</span></div>
    <dl class="property-terms" data-card-terms={cottage.id}>
      <div><dt>Monthly</dt><dd class="property-price" data-term="rate">{terms.rate}</dd></div>
      <div><dt>Move-in</dt><dd data-term="available">{terms.available}</dd></div>
      {terms.minimumStay && <div><dt>Stay</dt><dd data-term="minimum-stay">{terms.minimumStay}</dd></div>}
    </dl>
    <a class="property-link" href={mainHref}>Explore the home site <span aria-hidden="true">↗</span></a>
  </div>
</article>
