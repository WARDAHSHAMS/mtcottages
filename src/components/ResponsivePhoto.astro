---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import type { Photo } from "../data/site";

interface Props extends Photo {
  widths?: number[];
  sizes?: string;
  loading?: "eager" | "lazy";
  priority?: boolean;
  class?: string;
}

const { src, alt, caption, focal, widths = [640, 960, 1280], sizes = "(max-width: 900px) 100vw, 70vw", loading = "lazy", priority = false, class: className } = Astro.props;
// Without an explicit width, Astro renders the fallback `src` at the source file's full
// resolution (2400px for some portfolio frames, over 300 KB as AVIF) even though the
// srcset never offers more than the largest width. Cap it at the largest srcset width,
// or at the source width when the source is smaller (Astro drops srcset widths above it
// and sharp never upscales), so the width attribute matches the file actually served.
// Read the source width through the metadata's hidden `clone`, exactly as Astro's own
// getImage does: a direct read such as src.width trips the metadata proxy, which then
// copies the untouched original into dist (2 MB+ concept PNGs fail check-dist).
type ClonableImageMetadata = ImageMetadata & { readonly clone?: ImageMetadata };
const sourceWidth = ((src as ClonableImageMetadata).clone ?? src).width;
const width = Math.min(Math.max(...widths), sourceWidth);
---

<Image
  src={src}
  alt={alt}
  widths={widths}
  width={width}
  sizes={sizes}
  format="avif"
  loading={priority ? "eager" : loading}
  decoding="async"
  fetchpriority={priority ? "high" : "auto"}
  style={focal ? `object-position:${focal}` : undefined}
  class={className}
  data-caption={caption}
  {...(priority ? { "data-priority": "true" } : {})}
/>
