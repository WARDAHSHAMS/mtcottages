---
/**
 * Reusable step diagram for guides (#47): a numbered sequence drawn with
 * inline SVG markers and connectors. The steps are a real ordered list, so a
 * screen reader hears "list, 4 items" and the text, not a picture; the SVG is
 * decoration. Steps run left to right on wide screens and stack on phones.
 */
import type { DiagramSpec } from "../../data/guides";

interface Props { diagram: DiagramSpec }
const { diagram } = Astro.props as Props;
const titleId = `${diagram.id}-title`;
---
<figure class="gd" aria-labelledby={titleId} data-guide-diagram={diagram.id}>
  <figcaption id={titleId} class="gd-title">{diagram.title}</figcaption>
  <ol class="gd-steps">
    {diagram.steps.map((step, index) => (
      <li class="gd-step">
        <svg class="gd-marker" viewBox="0 0 40 40" width="40" height="40" aria-hidden="true" focusable="false">
          <circle cx="20" cy="20" r="18" />
          <text x="20" y="25.5" text-anchor="middle">{index + 1}</text>
        </svg>
        <strong>{step.label}</strong>
        <span>{step.detail}</span>
        {index < diagram.steps.length - 1 && (
          <svg class="gd-arrow" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
            <path d="M4 12h14M13 6l6 6-6 6" />
          </svg>
        )}
      </li>
    ))}
  </ol>
</figure>

<style>
  .gd { margin: 1.5rem 0; padding: clamp(1rem, .6rem + 1.6vw, 1.75rem); border: 1px solid var(--line); border-radius: .9rem; background: #fff; }
  .gd-title { margin-bottom: 1rem; font-weight: 800; font-size: 1.05rem; }
  .gd-steps { display: grid; gap: 1.25rem; margin: 0; padding: 0; list-style: none; }
  .gd-step { position: relative; display: grid; gap: .35rem; align-content: start; padding-left: 3.25rem; min-height: 2.5rem; }
  .gd-step strong { color: var(--ink); }
  .gd-step span { color: var(--muted); font-size: .92rem; }
  .gd-marker { position: absolute; top: 0; left: 0; }
  .gd-marker circle { fill: var(--forest); }
  .gd-marker text { fill: #fff; font: 800 16px var(--body); }
  .gd-arrow { position: absolute; left: .5rem; bottom: -1.3rem; transform: rotate(90deg); }
  .gd-arrow path { fill: none; stroke: var(--accent-ink); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  @media (min-width: 760px) {
    .gd-steps { grid-template-columns: repeat(auto-fit, minmax(0, 1fr)); grid-auto-flow: column; gap: 2rem; }
    .gd-step { padding-left: 0; padding-top: 3.25rem; }
    .gd-arrow { left: auto; right: -1.75rem; top: .5rem; bottom: auto; transform: none; }
  }
  @media (forced-colors: active) {
    .gd-marker circle { fill: Highlight; }
    .gd-marker text { fill: HighlightText; }
    .gd-arrow path { stroke: CanvasText; }
  }
</style>
