---
import type { HomeShell } from "./shell";
import CheckDates from "../CheckDates.astro";

interface Props {
  shell: HomeShell;
  extra?: { label: string; href: string };
}
const { shell, extra } = Astro.props as Props;
---
<section class="section section--dark hm-inquiry" aria-labelledby="hm-inquiry-title">
  <div class="site-width split">
    <div>
      <p class="eyebrow" style="color:#e4b482">{shell.name}</p>
      <h2 id="hm-inquiry-title">Ask about {shell.name}.</h2>
    </div>
    <div>
      <p class="lede lede--light">Tell us your dates, who is coming, and what you need from a place. We confirm availability, the monthly rate, and the next step.</p>
      <CheckDates class="mt-3" placement="inquiry-panel" home={shell.id} tone="light" secondary={extra} />
    </div>
  </div>
</section>
