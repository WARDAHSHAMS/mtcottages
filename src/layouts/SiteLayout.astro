---
import "../styles/site.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteLightbox from "../components/SiteLightbox.astro";
import Analytics from "../components/Analytics.astro";
import { checkDatesLabel, homeName, isAudience, isHomeId, stayLink, type StayTown } from "../data/stay-link";
import { breadcrumbSchema, businessSchema, type Crumb, type SchemaNode } from "../data/schema";
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import favicon from "../../assets/images/fav-icon/icon.png";
import socialImage from "../../assets/images/cottages/marietta-01/frederick-exterior-full-safe.avif";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  noindex?: boolean;
  /** The page's own JSON-LD (built with the typed helpers in src/data/schema.ts). */
  schema?: SchemaNode | SchemaNode[];
  socialImage?: ImageMetadata;
  socialImageAlt?: string;
  /** Opaque house id of the home this page is about. Every "Check dates" link on the page carries it (#20), and it is counted with page views and inquiry clicks (#23). */
  home?: string;
  /** Audience slug this page speaks to (see src/data/stay-link.ts); carried and counted the same way. */
  audience?: string;
  /** Town a town page is about; its "Check dates" links pre-select it when no home is known. */
  town?: StayTown;
  /** Visible breadcrumb trail to publish as a BreadcrumbList (first crumb is Home). */
  breadcrumbs?: Crumb[];
}
const { title, description, canonical, noindex = false, schema, socialImage: pageSocialImage, socialImageAlt, home: homeProp, audience: audienceProp, town, breadcrumbs } = Astro.props;
const home = isHomeId(homeProp) ? homeProp : undefined;
const audience = isAudience(audienceProp) ? audienceProp : undefined;
// One context for the header, mega panels, mobile bar and footer, so the home and
// audience survive whichever inquiry link a visitor uses.
const stay = { href: stayLink({ home, audience, town, page: Astro.url.pathname }), label: checkDatesLabel(home), homeName: homeName(home) };
const canonicalUrl = canonical || new URL(Astro.url.pathname, "https://mtcottages.com").toString();
const socialAsset = pageSocialImage ?? socialImage;
// Link-preview crawlers (Facebook, LinkedIn, iMessage, Slack) do not read AVIF,
// so shared links get a JPEG rendition of the page image.
const socialJpeg = await getImage({ src: socialAsset, format: "jpg", width: Math.min(1200, socialAsset.width), quality: 82 });
const socialUrl = new URL(socialJpeg.src, "https://mtcottages.com").toString();
// Chromium prerenders a same-site page as soon as a visitor signals intent
// (hover or touch start), so the click lands on an already-rendered page.
const speculationRules = {
  prerender: [{
    where: { and: [{ href_matches: "/*" }, { not: { selector_matches: "[target=_blank], [download], [rel~=nofollow]" } }] },
    eagerness: "moderate",
  }],
};
// The one business node (stable @id, identical on every page, so it always
// uses the site's default image), plus the page's own schema and breadcrumbs.
const businessJpeg = pageSocialImage ? await getImage({ src: socialImage, format: "jpg", width: Math.min(1200, socialImage.width), quality: 82 }) : socialJpeg;
const schemas = [
  businessSchema(new URL(businessJpeg.src, "https://mtcottages.com").toString()),
  ...(schema ? (Array.isArray(schema) ? schema : [schema]) : []),
  ...(breadcrumbs ? [breadcrumbSchema(breadcrumbs)] : []),
];
// Google Search Console HTML-tag verification. The token is public (it is
// printed in the page), so it comes from a PUBLIC_ build variable that the
// owner sets once; with no token the tag is simply left out.
const searchConsoleToken = (import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION ?? "").trim();
if (searchConsoleToken && !/^[A-Za-z0-9_-]{20,100}$/.test(searchConsoleToken)) {
  throw new Error("PUBLIC_GOOGLE_SITE_VERIFICATION must be only the content value of Google's meta tag, not the whole tag");
}
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalUrl} />
    {searchConsoleToken && <meta name="google-site-verification" content={searchConsoleToken} />}
    <link rel="icon" href={favicon.src} />
    {/* The two fonts the first screen paints with (body copy and the h1); the bold body weight loads when it is first used. */}
    <link rel="preload" href="/fonts/source-sans-3-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/source-serif-4-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Mt Cottages" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialUrl} />
    <meta property="og:image:alt" content={socialImageAlt || "A furnished Mt Cottages home in the Mid-Ohio Valley"} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content={String(socialJpeg.attributes.width)} />
    <meta property="og:image:height" content={String(socialJpeg.attributes.height)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#1d4b68" />
    <script type="application/ld+json" set:html={JSON.stringify(schemas)} />
    <script type="speculationrules" set:html={JSON.stringify(speculationRules)} />
    <title>{title}</title>
  </head>
  <body data-home={home} data-audience={audience}>
    <SiteHeader stay={stay} />
    <main id="main-content"><slot /></main>
    <aside class="mobile-action" aria-label="Check dates shortcut" data-cta="mobile-bar">
      <span>{stay.homeName ? <><strong>{stay.homeName}</strong><small>Tell us your dates and household.</small></> : <><strong>Planning a furnished stay?</strong><small>Tell us your dates and household.</small></>}</span>
      <a href={stay.href}>Check dates</a>
    </aside>
    <SiteFooter stay={stay} />
    <SiteLightbox />
    <Analytics />
  </body>
</html>
