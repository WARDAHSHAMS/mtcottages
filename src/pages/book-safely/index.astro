---
import SiteLayout from "../../layouts/SiteLayout.astro";
import CheckDates from "../../components/CheckDates.astro";
import RelatedLinks from "../../components/RelatedLinks.astro";
import { homes } from "../../data/homes";
import { homeBase } from "../../data/homes/links";
import { pageTitle, placeName } from "../../data/seo";
import { stayApplicationUrl, type RelatedLink } from "../../data/site";
import type { Crumb } from "../../data/schema";

// "How to book safely" (#62). Every statement comes from a fact the site already publishes or the owner
// decided; keep it that way, and change this page in the same MR as any change to those facts:
// - the inquiry channels: the stay form (stayApplicationUrl) and stay@mtcottages.com (src/data/schema.ts);
// - payment: every stay pays through Furnished Finder and KeyCheck, and no booking is held before payment
//   (owner decision #70, notes/owner-decisions.md; published in src/data/corporateHousing.ts);
// - the inquiry asks for no payment, Social Security number or bank details (the stay form's own notice,
//   and the travel-nurse hub's scam answer in src/data/travelNurses.ts);
// - the Furnished Finder listing names come from src/data/terms.json;
// - the four homes that publish a street address are the ones approved in CLAUDE.md.
// No phone number is published, so none appears here. The reporting agencies are the US federal ones.
const href = "/book-safely/";
const crumbs: Crumb[] = [
  { name: "Home", href: "/" },
  { name: "Book safely", href },
];
const contact = "stay@mtcottages.com";
const stayHost = new URL(stayApplicationUrl).host;
const addressHomeIds = ["frederick", "henrietta", "oak", "broad"];
const addressHomes = homes.filter((home) => addressHomeIds.includes(home.id));
if (addressHomes.length !== addressHomeIds.length) throw new Error("book-safely: a home that publishes its address is no longer listed");
const related: RelatedLink[] = [
  { href: "/travel-nurses/", label: "Travel nurse housing", note: "Furnished homes near the hospitals, for 13-week contracts and longer." },
  { href: "/corporate-housing/", label: "Corporate and crew housing", note: "How company-paid stays work, step by step." },
  { href: "/cottages.html", label: "Every Mt Cottages home", note: "The real homes, with their own photos and pages." },
  { href: "/privacy.html", label: "Privacy notice", note: "What the stay form collects and how we use it." },
];
---
<SiteLayout
  title={pageTitle("How to book safely")}
  description="How to book a Mt Cottages furnished home safely: our only booking channels, what we never ask you to pay with, how to check a listing, and how to report a scam."
  breadcrumbs={crumbs}
>
  <section class="guide-hero section--tight">
    <div class="site-width">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Book safely</span>
      </nav>
      <p class="eyebrow mt-3">Book safely</p>
      <h1>How to book a Mt Cottages home safely.</h1>
      <p class="lede reading">Rental scams copy real photos and real listings. Here is how to tell that you are dealing with us: the only ways to book, what we never ask you to pay with, how to check a listing, and what to do if something looks wrong. If you are unsure, email <a href={`mailto:${contact}`}>{contact}</a> before you pay anyone.</p>
    </div>
  </section>

  <section class="section section--paper">
    <div class="site-width prose">
      <article class="prose-section" id="channels">
        <h2>The only ways to book with us</h2>
        <div class="stack">
          <p>Every Mt Cottages stay starts in one of two places and is paid in one way.</p>
          <ul>
            <li><strong>The stay form at {stayHost}.</strong> Every "Check dates" button on mtcottages.com opens it. It asks for your dates, who is coming and how to reach you. It never asks for payment, a Social Security number or bank details, and an inquiry is a conversation, not a lease.</li>
            <li><strong>Email to <a href={`mailto:${contact}`}>{contact}</a>.</strong> That is our address. Be wary of a lookalike, such as a different spelling or a free email account using our name.</li>
            <li><strong>Payment through Furnished Finder and KeyCheck.</strong> Every Mt Cottages stay is paid through that same flow, month to month or with three months paid. We confirm the home, the dates, the price and what is included in writing before you commit, and we hold no booking before payment.</li>
          </ul>
        </div>
      </article>

      <article class="prose-section" id="never">
        <h2>What we never ask for</h2>
        <div class="stack">
          <p>Because every payment goes through Furnished Finder and KeyCheck, a request for any of these did not come from us:</p>
          <ul>
            <li>Payment by gift card.</li>
            <li>Payment by wire transfer.</li>
            <li>A deposit or rent paid into someone's personal bank account.</li>
            <li>Card numbers, bank logins or a Social Security number by email or text. Never email them to anyone, us included.</li>
          </ul>
          <p>Pressure is a warning sign too: a stranger who says the home will go to someone else unless you pay today, or who will not show you the terms in writing first.</p>
        </div>
      </article>

      <article class="prose-section" id="verify">
        <h2>How to check a listing is really ours</h2>
        <div class="stack">
          <ul>
            <li><strong>Find the home here first.</strong> Every home we offer has its own page on mtcottages.com, with photos of the actual home. If a listing shows one of our homes, compare it with that home's page.</li>
            <li><strong>Look up the address.</strong> {addressHomes.map((home, index) => <>{index > 0 && (index === addressHomes.length - 1 ? " and " : ", ")}<a href={homeBase(home)}>{home.name}</a></>)} publish their street addresses on their own pages, so you can check them on a map.</li>
            <li><strong>Check the name on Furnished Finder.</strong> Our listings there carry the Mt Cottages name, such as "Broad St Bungalow by Mt Cottages" and "Oak House by Mt Cottages". Our photos under another name, with another email address or phone number, are not ours.</li>
            <li><strong>Compare the price.</strong> A home's page shows its monthly rate or says to confirm it on inquiry. A listing for one of our homes at a much lower price is a common sign of a copied listing.</li>
            <li><strong>Ask us.</strong> Send an inquiry through the stay form or email <a href={`mailto:${contact}`}>{contact}</a> with a link to the listing, and we will tell you whether it is ours before you pay anything.</li>
          </ul>
          <p>The homes we list today:</p>
          <ul data-homes>
            {homes.map((home) => <li><a href={homeBase(home)}>{home.name}</a>, {placeName(home.town)}</li>)}
          </ul>
        </div>
      </article>

      <article class="prose-section" id="report">
        <h2>If you think you have found a scam</h2>
        <div class="stack">
          <ol>
            <li><strong>Stop.</strong> Do not send money, codes or personal details, and do not open links or attachments the sender pushes you to use.</li>
            <li><strong>Tell us.</strong> Email <a href={`mailto:${contact}`}>{contact}</a> with a link to the listing or a screenshot, and the messages you received. We can confirm whether it is one of our homes.</li>
            <li><strong>Report the listing</strong> to the website or app it is on, using that site's own report tool, so it can be taken down for the next person.</li>
            <li><strong>If you have already paid,</strong> contact your bank, card issuer or the gift card company straight away; the sooner you call, the better the chance of stopping the payment.</li>
            <li><strong>Report it to the authorities.</strong> In the United States, report fraud to the Federal Trade Commission at <a href="https://reportfraud.ftc.gov/">ReportFraud.ftc.gov</a>, and online fraud to the FBI's Internet Crime Complaint Center at <a href="https://www.ic3.gov/">ic3.gov</a>.</li>
          </ol>
        </div>
      </article>

      <article class="prose-section" id="ready">
        <h2>Ready to ask about a home?</h2>
        <div class="stack">
          <p>Send your dates through the stay form. We reply with the homes that fit, their current price and what is included.</p>
          <CheckDates placement="book-safely" />
        </div>
      </article>
    </div>
  </section>

  <RelatedLinks links={related} heading="Where to go next." />
</SiteLayout>
