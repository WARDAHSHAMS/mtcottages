---
import SiteLayout from "../../../layouts/SiteLayout.astro";
import CheckDates from "../../../components/CheckDates.astro";
import CottageBrowser from "../../../components/CottageBrowser.astro";
import { cottages } from "../../../data/site";
import { pageTitle } from "../../../data/seo";
import { faqSchema, type Crumb } from "../../../data/schema";
import { policiesHref } from "../../../data/policies";
import { monthlyFaqs, monthlyHref, stayLengths, townLinks } from "../../../data/monthlyStays";

// The monthly furnished stays hub (#64). Only confirmed terms are stated (src/data/monthlyStays.ts);
// the home grid is the same filterable browser as /cottages.html, reading src/data/terms.json.
const crumbs: Crumb[] = [
  { name: "Home", href: "/" },
  { name: "Monthly furnished stays", href: monthlyHref },
];
---
<SiteLayout
  title={pageTitle("Monthly Furnished Rentals, 30 Days and Up")}
  description="Monthly furnished stays in Marietta, Ohio, Parkersburg and Ravenswood, WV: 30 days or more, 13-week contracts, utilities included, homes by town and size."
  breadcrumbs={crumbs}
  schema={faqSchema(monthlyHref, monthlyFaqs)}
>
  <section class="guide-hero section--tight">
    <div class="site-width">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Monthly furnished stays</span>
      </nav>
      <p class="eyebrow mt-3">Monthly stays</p>
      <h1>Monthly furnished stays in the Mid-Ohio Valley.</h1>
      <p class="lede reading">Whole furnished homes for a month or longer in Marietta, Ohio, Parkersburg and Ravenswood, West Virginia, with utilities included. Pick a stay length, then filter the homes by town and size.</p>
    </div>
  </section>

  <section class="section section--paper">
    <div class="site-width">
      <h2>How long can you stay?</h2>
      <ul class="ms-lengths mt-3" data-stay-lengths>
        {stayLengths.map((length) => (
          <li>
            <h3>{length.title}</h3>
            <p>{length.body}</p>
            <a class="text-link" href={length.href}>{length.linkLabel}</a>
          </li>
        ))}
      </ul>
      <p class="mt-3">The house rules, deposits and cancellation are on the <a href={policiesHref}>stay policies</a> page.</p>
    </div>
  </section>

  <section class="section">
    <div class="site-width">
      <h2>Find a home for your month</h2>
      <CottageBrowser cottages={cottages} />
      <p class="mt-4">Or start from a town:</p>
      <ul class="ms-towns" data-town-links>
        {townLinks.map((town) => <li><a href={town.href}>{town.name}</a></li>)}
      </ul>
    </div>
  </section>

  <section class="section section--paper">
    <div class="site-width prose">
      <h2>Monthly stay questions</h2>
      <div class="stack" data-monthly-faq>
        {monthlyFaqs.map((faq) => (
          <details>
            <summary>{faq.q}</summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </div>
      <CheckDates placement="monthly-hub" secondary={{ label: "Read the stay policies", href: policiesHref }} />
    </div>
  </section>
</SiteLayout>

<style>
  .ms-lengths { display: grid; gap: 1rem; margin: 0; padding: 0; list-style: none; }
  .ms-lengths li { display: grid; gap: .5rem; align-content: start; padding: 1.1rem; border: 1px solid var(--line); border-radius: .9rem; background: #fff; }
  .ms-lengths h3 { color: var(--forest); }
  .ms-towns { display: flex; flex-wrap: wrap; gap: .5rem 1.25rem; margin: .5rem 0 0; padding: 0; list-style: none; }
  [data-monthly-faq] details { padding: .8rem 0; border-bottom: 1px solid var(--line); }
  [data-monthly-faq] summary { color: var(--forest); font-weight: 600; cursor: pointer; }
  [data-monthly-faq] details p { margin-top: .5rem; }
  @media (min-width: 760px) { .ms-lengths { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
